# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API). Leave them empty to play fully offline.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show the admin panel when no server is connected (local testing). With a server, only admins see it.
VITE_LOCAL_ADMIN=true
